# 复制本文件为 .env，然后把右侧占位值换成你自己的配置。
# 推荐把聊天模型和 Embedding 模型分开配置：
# - CHAT_*：用于客服回复、工具调用决策。
# - EMBEDDING_*：用于 RAG，把文档和查询转成向量。

APP_NAME="LangChain Customer Service Agent"
APP_ENV="dev"
COMPANY_NAME="你的公司名称"
SUPPORT_EMAIL="support@example.com"
LOG_LEVEL="INFO"

# 聊天模型。示例：DeepSeek、Qwen、OpenAI-compatible 网关等。
CHAT_API_KEY="your-chat-api-key"
CHAT_BASE_URL="https://api.deepseek.com"
CHAT_MODEL_NAME="deepseek-v4-pro"

# Embedding 模型。必须选择支持 /embeddings 的服务，不能填聊天模型名。
EMBEDDING_API_KEY="your-embedding-api-key"
EMBEDDING_BASE_URL="https://your-embedding-provider/v1"
EMBEDDING_MODEL_NAME="your-embedding-model-name"

# 旧版兼容配置：如果你只用一个同时支持 chat 和 embeddings 的 OpenAI-compatible 服务，
# 也可以继续只填 OPENAI_*。新项目更建议使用上面的 CHAT_* 和 EMBEDDING_*。
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL_NAME=""
OPENAI_EMBEDDING_MODEL_NAME=""

AGENT_TEMPERATURE="0.2"
AGENT_VERBOSE="true"
# 默认使用 Supervisor + 订单/物流/售后；single 可切回原版学习。
AGENT_MODE="multi"
MULTI_AGENT_MAX_CONCURRENCY="3"
MULTI_AGENT_TASK_TIMEOUT_SECONDS="45"
MULTI_AGENT_MAX_ATTEMPTS="2"
SUPERVISOR_TIMEOUT_SECONDS="45"
AGENT_RECURSION_LIMIT="20"
MODEL_TIMEOUT_SECONDS="60"
MODEL_MAX_RETRIES="2"
EMBEDDING_CHECK_CTX_LENGTH="false"

MEMORY_DB_PATH="data/agent_memory.sqlite3"
MULTI_AGENT_DB_PATH="data/multi_agent_checkpoints.sqlite3"
AFTER_SALES_DB_PATH="data/after_sales.sqlite3"
PROFILE_DB_PATH="data/customer_profiles.sqlite3"
RAG_DB_PATH="data/rag_chunks.sqlite3"
TICKET_DB_PATH="data/tickets.sqlite3"
KNOWLEDGE_BASE_DIR="data/knowledge_base"
SQLITE_BUSY_TIMEOUT_SECONDS="30"
MEMORY_RECENT_TURNS="6"
MEMORY_SUMMARY_ENABLED="true"
MEMORY_SUMMARY_MAX_CHARS="4000"
MEMORY_SUMMARY_INPUT_MAX_CHARS="20000"
# 长期画像：每用户一行、覆盖摘要、保留近期事实。字节预算包括UTF-8中文。
MEMORY_PROFILE_MAX_ORDERS="20"
MEMORY_PROFILE_MAX_PREFERENCES="10"
MEMORY_PROFILE_SUMMARY_MAX_CHARS="800"
MEMORY_PROFILE_MAX_BYTES="8192"
# 0不按年龄删画像；例如180表示维护时删除180天未更新事实的画像。
MEMORY_PROFILE_RETENTION_DAYS="0"
# 维护命令按每个会话+namespace保留N个checkpoint，注意不是N轮。
MEMORY_CHECKPOINT_KEEP_LAST="20"
RAG_CHUNK_SIZE="700"
RAG_CHUNK_OVERLAP="100"
RAG_TOP_K="3"
RAG_MIN_SCORE="0.0"
# 两路独立取候选；余弦阈值应根据你使用的embedding与评测集校准。
RAG_BRANCH_TOP_K="3"
RAG_SEMANTIC_MIN_SCORE="0.35"
RAG_LOCAL_TIMEOUT_SECONDS="15"
RAG_RETRIEVAL_WORKERS="4"

# 真正的Rerank模型，不是OpenAI /v1/chat/completions。URL填写完整地址，不自动补路径。
# - dashscope：百炼原生协议，URL为控制台对应地域/空间的text-rerank地址；模型如qwen3-rerank。
# - jina：Jina/Cohere兼容协议，URL一般是网关的 .../v1/rerank；模型如jina-reranker-m0。
# 三项留空时会明确显示not_configured，并使用RRF名次融合，不伪装成模型排序。
RAG_RERANK_ENABLED="true"
RAG_RERANK_API_FORMAT="dashscope"
RAG_RERANK_API_URL=""
RAG_RERANK_API_KEY=""
RAG_RERANK_MODEL_NAME=""
RAG_RERANK_TOP_N="3"
RAG_RERANK_MAX_CANDIDATES="20"
RAG_RERANK_TIMEOUT_SECONDS="10"
RAG_RERANK_MAX_DOCUMENT_CHARS="2000"
RAG_RERANK_MIN_SCORE="0.0"
RAG_RRF_K="60"

# 网页降级通过浏览器MCP，而不是本项目的客服MCP Server。
# stdio会启动独立Playwright MCP进程；需安装Node.js与Chrome，首次npx会下载包。
RAG_WEB_FALLBACK_ENABLED="true"
RAG_WEB_MCP_TRANSPORT="stdio"
RAG_WEB_MCP_COMMAND="npx"
RAG_WEB_MCP_ARGS='["-y", "@playwright/mcp@0.0.83", "--headless", "--isolated"]'
RAG_WEB_MCP_CACHE_DIR="data/mcp_npm_cache"
# 使用已启动的Streamable HTTP服务器时，改transport并填写其/mcp地址。
RAG_WEB_MCP_URL=""
RAG_WEB_MCP_TOKEN=""
RAG_WEB_SEARCH_URL="https://www.bing.com/search"
RAG_WEB_TIMEOUT_SECONDS="30"
RAG_WEB_MAX_CHARS="12000"

API_HOST="127.0.0.1"
API_PORT="8000"
# 生产环境必须填写；用于保护 RAG 入库和清空记忆等管理接口。
ADMIN_API_KEY=""
